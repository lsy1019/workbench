{
  "name": "lml-workbench",
  "private": true,
  "version": "1.0.0",
  "description": "L_ML的个人专属工作台",
  "author": "L_ML",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --dir",
    "electron:dist": "vite build && electron-builder",
    "electron:dist:win": "vite build && electron-builder --win",
    "electron:dist:mac": "vite build && electron-builder --mac",
    "electron:dist:linux": "vite build && electron-builder --linux"
  },
  "build": {
    "appId": "com.lml.workbench",
    "productName": "L_ML工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "icon": "public/icons/icon-512x512.png"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/icons/icon-512x512.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "icon": "public/icons/icon-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icons/icon-512x512.png"
    }
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.1",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.0.1",
    "wait-on": "^8.0.4"
  }
}
